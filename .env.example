# ==============================================================================
# DataPilot AI - Environment Configuration Example
# Copy this file to backend/.env and frontend/.env.local respectively
# ==============================================================================

# Backend (FastAPI) - placed in backend/.env
APP_NAME="DataPilot AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=100
MAX_PREVIEW_ROWS=500

# Frontend (Next.js) - placed in frontend/.env.local
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
